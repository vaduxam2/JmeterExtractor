/**
 * Вспомогательный класс, который хранит целевой SampleResult, cookie и таймаут,
 * а также отвечает за заполнение полей результата для отображения в дереве результатов JMeter.
 */
@CompileStatic
class ResultSampler {
    private final SampleRes resultSampler   // Ссылка на SampleResult текущего сэмплера
    protected final String cookie           // Начальное значение Cookie (может обновляться динамически, но здесь статично)
    protected final int timeoutSec          // Таймаут в секундах
    protected int iteration = 0               // Счётчик итераций (для логов)

    ResultSampler(SampleRes resultSampler, int timeoutSec, String cookie) {
        this.resultSampler = resultSampler
        this.timeoutSec = timeoutSec
        this.cookie = cookie
    }

    /**
     * Заполняет JSR-233 SampleResult всеми необходимыми данными для просмотра в ViewResultsTree:
     * - тело запроса (samplerData)
     * - заголовки запроса (requestHeaders)
     * - код ответа, успешность, сообщение, тело ответа, заголовки ответа
     *
     * @param headers        менеджер заголовков запроса (для вывода в дерево)
     * @param httpSampler    сэмплер (для получения метода и URL)
     * @param success        true — успех, false — ошибка, null — таймаут
     * @param response       объект SampleResult ответа (может быть null при таймауте)
     * @param responseStr    тело ответа (если передано отдельно, иначе берётся из response)
     */
    protected void showViewResultsTree(
            HeaderManager headers,
            HTTPSamplerProxy httpSampler,
            Boolean success,
            SampleRes response,
            String responseStr = ""
    ) {
        iteration++ // увеличиваем счётчик итераций

        // --- Формирование тела запроса (POST data) ---
        StringBuilder sb = new StringBuilder("${httpSampler.getMethod()} ${httpSampler.getUrl().toString()}\n\nPOST data:\n")
        Map<String, String> args = httpSampler.getArguments().getArgumentsAsMap()
        if (args) {
            sb.append(args.collect { k, v -> "${k}=${v}" }.join("&"))
        }
        sb.append("\n\nCookie Data:\n${cookie}")
        resultSampler.setSamplerData(sb.toString())   // Устанавливаем тело запроса для отображения в Request

        // --- Формирование заголовков запроса ---
        sb.setLength(0)  // очищаем StringBuilder
        headers.getHeaders().each { prop ->
            Header h = prop.getObjectValue() as Header
            sb.append("${h.getName()}: ${h.getValue()}\n")
        }
        resultSampler.setRequestHeaders(sb.toString()) // Устанавливаем заголовки запроса

        // --- Заполнение полей ответа в зависимости от статуса ---
        if (success == null) {
            // Таймаут: ответа нет или он неполный
            resultSampler.setResponseCode(response ? response.getResponseCode() : "-1")
            resultSampler.setSuccessful(false)
            resultSampler.setResponseMessage(" Таймаут(${timeoutSec} сек) ожидания ответа импорта от сервера, итерация=${iteration}")
            resultSampler.setResponseData(
                    responseStr ?: (response ? response.getResponseDataAsString() : "TIMEOUT ERROR"),
                    "UTF-8"
            )
        } else {
            // Успех или ошибка (обработка завершена)
            resultSampler.setResponseCode(response.getResponseCode())
            resultSampler.setSuccessful(success)
            resultSampler.setResponseMessage(" статус=${success}, итерация=${iteration}")
            resultSampler.setResponseData(
                    responseStr ?: response.getResponseDataAsString(),
                    "UTF-8"
            )
        }

        // --- Формирование заголовков ответа (из реального ответа) ---
        sb.setLength(0)  // очищаем StringBuilder
        ;(response ? response.getResponseHeaders() : "").eachLine { line ->
            if (line.trim()) {
                sb.append(line.trim()).append("\n")
            }
        }
        resultSampler.setResponseHeaders(sb.toString()) // Устанавливаем заголовки ответа
    }
}

