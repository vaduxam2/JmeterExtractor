/**
 * Основной класс, реализующий логику опроса сервера до получения финального статуса
 * или истечения таймаута.
 */
@CompileStatic
class Dummy {
    private static Logger log
    Dummy(
            SampleRes sampleResult,          // Результат текущего сэмплера
            JMeterContext ctx,               // Контекст потока
            String desktopId,                // Имя переменной с desktopId - "Desktop_142"
            String server,                   // Имя переменной с сервером -
            String port,                     // Имя переменной с портом - "4005"
            String poib_remote_user,         // Имя переменной с пользователем - "69d20ce2-c7a3-4694-a0ae-e4280487d344"
            String Cookie,                   // Имя переменной с начальной Cookie - "JSESSIONID=node0si9tr49cy8olrhm7cbgeisc275.node0"
            String importTimeout,            // Имя переменной с таймаутом - "120"
            String wait,                     // Имя переменной с интервалом - "1000"
            String strOk,                    // Имя переменной с текстом для успешной проверки ответа - "Успешно завершена"
            String strFail,                  // Имя переменной с текстом для неуспешной проверки ответа - "Завершена с ошибками"
            String path                      // Путь запроса (передан как строка, но может быть и фиксированным) - "/EXP/zkau"
    ) {
        // Получаем доступ к переменным JMeter через контекст
        JMeterVariables vars = ctx.getVariables()
        String timeout = (vars.get(importTimeout) ?: "60")
        int timeOut = timeout as Integer

        // Создаём вспомогательный объект для хранения результата и настроек
        ResultSampler resultSampler = new ResultSampler(
                sampleResult,
                timeOut,  // таймаут ожидания, по умолчанию 60 сек
                vars.get(Cookie) ?: ""  // начальное значение Cookie (может быть пустым)
        )

        // Извлекаем остальные параметры из переменных JMeter с значениями по умолчанию
        String srv = vars.get(server)                  // сервер
        int prt = vars.get(port) as int                // порт
        String user = vars.get(poib_remote_user)       // пользователь для заголовка poib-remote-user
        int waitMs = (vars.get(wait) ?: "1000") as int // интервал опроса, по умолчанию 1000 мс
        long endTime = System.currentTimeMillis() + timeOut * 1000L // время окончания ожидания
        String dId = vars.get(desktopId)

        // --- Создание HTTP-сэмплера с параметрами запроса ---
        HTTPSamplerProxy httpSampler = new HTTPSamplerProxy()
        httpSampler.setDomain(srv)
        httpSampler.setPort(prt)
        httpSampler.setProtocol("http")
        httpSampler.setPath(path)
        httpSampler.setMethod("POST")
        httpSampler.setFollowRedirects(true)
        httpSampler.setUseKeepAlive(true)
        httpSampler.setPostBodyRaw(false)  // параметры передаются как обычные form-data
        httpSampler.setConnectTimeout(timeout)
        httpSampler.setResponseTimeout(timeout)
        // Добавляем параметры тела запроса (dtid, cmd_0, opt_0)
        httpSampler.addArgument("dtid", dId)
        httpSampler.addArgument("cmd_0", "dummy")
        httpSampler.addArgument("opt_0", "i")

        // --- Формирование заголовков запроса ---
        HeaderManager headers = new HeaderManager()
        headers.add(new Header("poib-remote-user", user))
        headers.add(new Header("User-Agent", "Mozilla/5.0 (Windows NT 6.1; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/101.0.4951.64 Safari/537.36"))
        headers.add(new Header("Accept-Encoding", "gzip, deflate"))
        headers.add(new Header("Accept-Language", "ru"))
        headers.add(new Header("Referer", "http://${srv}:${prt}/"))
        headers.add(new Header("Origin", "http://${srv}:${prt}"))
        headers.add(new Header("Accept", "*/*"))
        headers.add(new Header("Content-Type", "application/x-www-form-urlencoded;charset=UTF-8"))
        headers.add(new Header("Cookie", resultSampler.cookie)) // начальная Cookie (может быть пустой)
        httpSampler.setHeaderManager(headers)

        // --- Переменные для хранения результата ---
        SampleRes response = null
        String responseStr = ""
        boolean status = false  // флаг успешного завершения (по умолчанию false)

        // --- Цикл опроса ---
        while (System.currentTimeMillis() < endTime) {
            // Генерируем новый ZK-SID и добавляем в заголовки (удаляем старый, если был)
            headers.removeHeaderNamed("ZK-SID")
            headers.add(new Header("ZK-SID", ThreadLocalRandom.current().nextInt(1_000_000_000).toString()))

            // Выполняем запрос
            response = httpSampler.sample(null)
            responseStr = response.getResponseDataAsString()

            // ############################################################################
            // Формируем подробное лог-сообщение для отладки
            StringBuilder logMsg = new StringBuilder()
            logMsg.append("\n========== ЗАПРОС (Итерация ${resultSampler.iteration + 1})  ${srv} ==========\n")
            logMsg.append("🌐 URL: ${httpSampler.getProtocol()}://${httpSampler.getDomain()}:${httpSampler.getPort()}${httpSampler.getPath()}\n")
            logMsg.append("📝 METHOD: ${httpSampler.getMethod()}\n")

            logMsg.append("\n📌 ЗАГОЛОВКИ ЗАПРОСА:\n")
            headers.getHeaders().each { prop ->
                Header h = prop.getObjectValue() as Header
                logMsg.append("  ${h.getName()}: ${h.getValue()}\n")
            }

            logMsg.append("\n📦 ТЕЛО ЗАПРОСА (POST data):\n")
            Map<String, String> args = httpSampler.getArguments().getArgumentsAsMap()
            if (args) {
                logMsg.append("  ").append(args.collect { k, v -> "${k}=${v}" }.join("&")).append("\n")
            } else {
                logMsg.append("  <ПУСТО>\n")
            }

            logMsg.append("\n========== ОТВЕТ СЕРВЕРА ==========\n")
            logMsg.append("🔢 Status Code: ${response.getResponseCode()}\n")
            logMsg.append("📄 RESPONSE BODY:\n${responseStr}\n")
            logMsg.append("============================================\n")

            log.info(logMsg.toString())
            // ############################################################################

            // Проверяем статус из ответа
            if (responseStr.contains(strOk)) {
                status = true  // успех
            } else if (!responseStr.contains(strFail)) {
                // Если нет ни успеха, ни ошибки, значит процесс ещё не завершён — ждём и продолжаем
                resultSampler.iteration++
                Thread.sleep(waitMs)
                continue
            }
            // Если достигли сюда, значит получен либо "Успешно завершена", либо "Завершена с ошибками"
            // Заполняем результат и выходим из метода
            resultSampler.showViewResultsTree(headers, httpSampler, status, response, responseStr)
            return
        }

        // Если цикл завершился по таймауту (не было ни успеха, ни ошибки)
        resultSampler.showViewResultsTree(headers, httpSampler, null, response, responseStr)  // null означает ошибку таймаута
    }
}

