/**
 * Статический класс-обёртка для запуска процесса ожидания ответа от сервера.
 * Предоставляет единую точку входа из JSR223 Sampler.
 * Параметры метода — имена переменных JMeter, из которых будут извлечены значения,
 * что позволяет гибко настраивать тест без изменения кода.
 */
@CompileStatic
class GetDummy {
    public static void waitDummyResponse(
            SampleRes sampleResult,          // Результат текущего сэмплера (для заполнения данными) - sampleResult
            JMeterContext ctx,               // Контекст JMeter (для доступа к переменным) - ctx
            String desktopId = "desktopId",  // Имя переменной с идентификатором рабочего стола - "Desktop_142"
            String server = "server",        // Имя переменной с адресом сервера -
            String port = "port",            // Имя переменной с портом - "4005"
            String poib_remote_user = "poib_remote_user", // Имя переменной с пользователем - "69d20ce2-c7a3-4694-a0ae-e4280487d344"
            String Cookie = "Cookie",        // Имя переменной с начальным значением Cookie (может быть пустым) - "JSESSIONID=node0si9tr49cy8olrhm7cbgeisc275.node0"
            String importTimeout = "importTimeout",       // Имя переменной с таймаутом (сек) - "120"
            String wait = "wait",            // Имя переменной с интервалом опроса (мс) - "1000"
            String strOk = "Успешно завершена",       // Имя переменной с текстом для успешной проверки ответа
            String strFail = "Завершена с ошибками",  // Имя переменной с текстом для неуспешной проверки ответа
            String path = "/EXP/zkau"        // Путь запроса (по умолчанию /EXP/zkau)
    ) {
        // Создаём экземпляр основного класса и запускаем процесс
        new Dummy(sampleResult, ctx, desktopId, server, port, poib_remote_user, Cookie, importTimeout, wait, strOk, strFail, path)
    }
}

