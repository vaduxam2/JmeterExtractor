@CompileStatic
class BoundaryExtractorBase {
    /**
     * Находит нужное вхождение правой границы и извлекает последовательность символов ID, идя назад.
     * @param varName        имя переменной (для сообщений об ошибках)
     * @param boundary             правая граница (текстовый маркер)
     * @param n  порядковый номер вхождения (если номер больше реального количества — берётся последнее):
     *                          1  = первое вхождение
     *                          2  = второе
     *                          -1 = последнее (по умолчанию)
     */
    protected static String extractBackward(String text, String boundary, int n, String varName = null) {
        int i = findNthOccurrence(text, boundary, n)
        if (i == -1) { throw new IllegalStateException("Не удалось извлечь varName='${varName}': правая граница '${boundary}' (вхождение #${n}) не найдена в ответе.") }
        int start = i  // Идём назад от найденной позиции, пока символы являются допустимыми для ID
        while (start > 0) { if (isIdChar(text.charAt(start - 1))) { start-- } else { break } }
        return text.substring(start, i)
    }

    /**
     * Находит нужное вхождение левой границы и извлекает последовательность символов ID, идя вперёд.
     * @param varName        имя переменной (для сообщений об ошибках)
     * @param rb             правая граница (текстовый маркер)
     * @param n  порядковый номер вхождения (если номер больше реального количества — берётся последнее):
     *                          1  = первое вхождение
     *                          2  = второе
     *                          -1 = последнее (по умолчанию)
     */
    protected static String extractForward(String text, String boundary, int n, String varName = null) {
        int i = findNthOccurrence(text, boundary, n)
        if (i == -1) { throw new IllegalStateException("Не удалось извлечь varName='${varName}': левая граница '${boundary}' (вхождение #${n}) не найдена в ответе.") }
        int start = i + boundary.length()
        int end = start  // Идём вперёд, пока символы являются допустимыми для ID
        int len = text.length()
        while (end < len) { if (isIdChar(text.charAt(end))) { end++ } else { break } }
        return text.substring(start, end)
    }

    /**
     * Находит N-ное вхождение подстроки в строке.
     * Правила:
     * - n == 1, 2, 3...  → соответствующее по порядку вхождение
     * - n <= 0           → последнее вхождение
     * - если N-ное не найдено → возвращается последнее существующее
     * @return индекс начала найденного вхождения или -1
     */
    protected static int findNthOccurrence(String text, String boundary, int n) {
        String b = StringEscapeUtils.escapeJava(boundary)
        if (n <= 0) { return text.lastIndexOf(b) }  // Отрицательные и нулевые значения трактуем как "последнее"
        int count = 0
        int idx = -1
        while (count < n) {
            idx = text.indexOf(b, idx + 1)
            if (idx == -1) { return text.lastIndexOf(b) }  // N-ное вхождение не найдено — возвращаем последнее
            count++
        }
        return idx
    }

    /** Проверяет, является ли символ допустимым внутри UUID/ID. Разрешённые символы: A-Z, a-z, 0-9, _, !, - */
    protected static boolean isIdChar(char s) {
        return (s >= (char) 'A' && s <= (char) 'Z') || (s >= (char) 'a' && s <= (char) 'z')
                || (s >= (char) '0' && s <= (char) '9')
                || s == (char) '_' || s == (char) '!' || s == (char) '-'
    }
}


