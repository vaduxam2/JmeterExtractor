/**
 * Базовый класс для всех экстракторов.
 * Содержит общие поля (логгер, переменные JMeter, ответ сервера) и вспомогательные методы сохранения результатов.
 */
@CompileStatic
class ResponseBoundaryBase {
    protected final Logger log  /** Логгер JMeter (org.slf4j.Logger) — используется для вывода отладочной информации */
    protected final JMeterVariables vars  /** Переменные текущего потока выполнения JMeter (vars) */
    protected final SampleResult prev  /** Результат последнего выполненного сэмплера (prev) — источник ответа сервера */
    protected boolean printMode  /** Флаг: выводить ли в лог каждую успешно созданную переменную */
    protected final String response  /** Тело ответа сервера в виде строки (кэшируется при создании объекта) */

    /**
     * Конструктор базового класса.
     * @param log          логгер JMeter
     * @param vars         переменные текущего потока
     * @param prev         результат последнего сэмплера
     * @param printMode    true — логировать каждую созданную переменную
     * @param testResponse опциональная строка ответа (для unit-тестов). Если передана — используется вместо prev.getResponseDataAsString()
     */
    ResponseBoundaryBase(Logger log, JMeterVariables vars, SampleResult prev, boolean printMode, String testResponse) {
        this.log = log
        this.vars = vars
        this.prev = prev
        this.printMode = printMode
        // Приоритет: testResponse > prev > ошибка
        if (testResponse != null) { this.response = testResponse }
        else if (prev != null) { this.response = prev.getResponseDataAsString() }
        else {
            this.response = null
            throw new IllegalStateException("Критическая ошибка: prev == null и testResponse не передан. Парсить нечего.")
        }
    }

    /**
     * Сохраняет извлечённый идентификатор в переменные JMeter. При включённом printMode дополнительно логирует результат.
     * @param varName      имя переменной JMeter
     * @param extractedId  извлечённый UUID / ID
     * @throws IllegalStateException если extractedId пустой
     */
    protected void varsPut(String varName, String extractedId) {
        if (!extractedId) { throw new IllegalStateException("Для '${varName}' извлечен пустой ID.") }
        vars.put(varName, extractedId)
        if (printMode) { logVar(varName, extractedId) }
    }

    /** Логирует успешно созданную переменную в формате: ### СОЗДАНА 'varName' = 'extractedId' */
    public void logVar(String varName, String extractedId) { log.info(" ### СОЗДАНА '{}' = '{}' ", varName, extractedId) }
    /** Вспомогательный метод для отладки: выводит транслитерированное имя и исходную текстовую метку. */
    public void printVarName(String bound) { log.info(" >>> '{}' для '{}' ", Translit.transliterate(bound), bound) }
}


// ####################################################################################################################################################################
/**
 * Основной класс извлечения идентификаторов по границам (Left Boundary / Right Boundary).
 * Реализует поиск UUID/ID относительно текстовых маркеров в ответе.
 */
@CompileStatic
class Extractor extends ResponseBoundaryBase {
    Extractor(Logger log, JMeterVariables vars, SampleResult prev, boolean printMode, String testResponse) { super(log, vars, prev, printMode, testResponse) }

    /**
     * Извлекает ID, идя НАЗАД от N-ного вхождения границы.
     * RESPONSE: "a1:'var1','v2'; a2:'var2','v2'; a3:'var3','v2'"
     *  byRB("id", "','v2'", -1) -> ${id}="var3"
     *  byRB("id", "','v2'", 2) -> ${id}="var2"
     */
    public String byRB(String varName, String rb, int n = -1) {
        vars.remove(varName)
        String v = BoundaryExtractorBase.extractBackward(response, rb, n, varName)
        vars.put(varName, v)
        return v
    }
    /**
     * Извлекает ID, идя ВПЕРЁД от N-ного вхождения границы.
     * RESPONSE: "a1:'var1','v2'; a2:'var2','v2'; a2:'var3','v2'"
     *  byLB("id", "a2:'", -1) -> ${id}="var2"
     *  byLB("id", "a2:'", 1) -> ${id}="var2"
     */
    public String byLB(String varName, String lb, int n = -1) {
        vars.remove(varName)
        String v = BoundaryExtractorBase.extractForward(response, lb, n, varName)
        vars.put(varName, v)
        return v
    }

    /**
     * Извлекает ID, между не примыкающим вплотную к ID текстом справа от ID, и левой границей.
     * Алгоритм:
     *  1. Находим (nr): N-ное(-1 = последнее) вхождение текста (rt), который находится ближе всего справа к ID.
     *  2. Берём весь текст слева от него.
     *  3. В этом тексте ищем (nl): N-ное(-1 = последнее) вхождение левой границы (lb).
     *  4. Берём ID справа от lb.
     * @param varName       имя переменной (для сообщений об ошибках)
     * @param lb            левая граница
     * @param rt            текст справа от ID, может не примыкать вплотную к ID
     * @param nl номер вхождения левой границы:
     *                      1  = первое вхождение
     *                      2  = второе
     *                      -1 = последнее (по умолчанию)
     * @param nr номер вхождения текста справа
     * RESPONSE: "a1:'var1','qweqw-qwsaxcz-qwe-12', 'контроль документа';"
     *  byLbBeforeRightText("id", "a1:'", "контроль документа", -1) -> ${id}="var1"
     */
    public String byLbBeforeRightText(String varName, String lb, String rt, int nl = -1, int nr = -1) {
        vars.remove(varName)
        int i = BoundaryExtractorBase.findNthOccurrence(response, rt, nr)  // Ищем N-ное вхождение правой границы
        if (i == -1) { throw new IllegalStateException("Не удалось извлечь varName='${varName}': не найден текст '${rt}' (вхождение #${nr})") }
        String r = response.substring(0, i)  // Берём всё, что находится ДО найденной правой границы
        String v = BoundaryExtractorBase.extractForward(r, lb, nl, varName)
        vars.put(varName, v)
        return v
    }

    /**
     * Извлекает ID после текста слева от ID, после которой идет левая граница.
     * Алгоритм:
     *  1. Находим (nt): N-ное(-1 = последнее) вхождение текста (lt), который находится ближе всего слева к ID.
     *  2. Берём весь текст справа от него.
     *  3. В этом тексте ищем (nl): N-ное(например 1 = первое) вхождение левой границы (lb).
     *  4. Берём ID справа от lb.
     * RESPONSE: " 'контроль документа','qweqw-qwsaxcz-qwe-11', a1:'var1','qweqw-qwsaxcz-qwe-12';"
     *  byTwoLb("id", "контроль документа", "a1:'", -1) -> ${id}="var1"
     */
    public String byTwoLb(String varName, String lt, String lb, int nt = -1, int nl = 1) {
        vars.remove(varName)
        int i = BoundaryExtractorBase.findNthOccurrence(response, lt, nt)  // Ищем N-ное вхождение текста слева
        if (i == -1) { throw new IllegalStateException("Не удалось извлечь varName='${varName}': не найден текст '${lt}' (вхождение #${nt})") }
        String r = response.substring(i + lt.length())  // Берём всё, что находится ПОСЛЕ найденной левой границы
        String v = BoundaryExtractorBase.extractForward(r, lb, nl, varName)
        vars.put(varName, v)
        return v
    }

    /**
     * Извлекает ID, содержащий в себе уникальную часть varPart.
     * Алгоритм:
     *  1. Находим N-ное вхождение varPart в ответе.
     *  2. Идём НАЗАД от начала varPart, пока символы валидны (isIdChar) — это prefix.
     *  3. Идём ВПЕРЁД от конца varPart, пока символы валидны (isIdChar) — это postfix.
     *  4. Собираем "${prefix}${varPart}${postfix}" и сохраняем в переменную varName.
     * @param varName имя переменной JMeter
     * @param varPart уникальная часть ID (текстовый маркер)
     * @param n       номер вхождения (1 = первое, 2 = второе, ..., <=0 = последнее)
     * RESPONSE: " 'контроль документа','qweqw-qwsaxcz-qwe-11', a1:'var_UNIQUE_1','qweqw-qwsaxcz-qwe-12';"
     *  byVarUniqueNamePart("id", "_UNIQUE_", -1) -> ${id}="var_UNIQUE_1"
     */
    public String byVarUniqueNamePart(String varName, String varPart, int n = -1) {
        vars.remove(varName)
        int i = BoundaryExtractorBase.findNthOccurrence(response, varPart, n)
        if (i == -1) { throw new IllegalStateException("Не удалось извлечь varName='${varName}': уникальная часть '${varPart}' (вхождение #${n}) не найдена в ответе.") }

        // Идём назад от начала varPart — собираем prefix
        int start = i
        while (start > 0 && BoundaryExtractorBase.isIdChar(response.charAt(start - 1))) { start-- }
        String prefix = response.substring(start, i)

        // Идём вперёд от конца varPart — собираем postfix
        int end = i + varPart.length()
        int len = response.length()
        while (end < len && BoundaryExtractorBase.isIdChar(response.charAt(end))) { end++ }
        String postfix = response.substring(i + varPart.length(), end)

        String v = prefix + varPart + postfix
        if (!v || v.length() == varPart.length()) { throw new IllegalStateException("Для '${varName}' извлечен пустой ID.") }
        vars.put(varName, v)
        if (printMode) { logVar(varName, v) }
        return v
    }
}

// ####################################################################################################################################################################
/**
 * Фабрика для создания экземпляров Extractor.
 * Регистрируется в глобальных свойствах JMeter (props), чтобы её можно было удобно вызывать из любых JSR223-элементов.
 * Пример использования в PostProcessor:
 *   def extractor = props.get("ResponseExtractor").getNewCls(log, vars, prev, true)
 *   extractor.extract(Extractor.NAVIGATION, "Operatsii_po_kassovym_vyplatam", "Операции по кассовым выплатам")
 */
@CompileStatic
class ResponseExtractor {
    /**
     * Создаёт и возвращает новый экземпляр Extractor.
     * @param log          логгер
     * @param vars         переменные потока
     * @param prev         результат предыдущего сэмплера
     * @param printMode    включить подробное логирование (по умолчанию false)
     * @param testResponse опциональная тестовая строка ответа (для отладки)
     */
    static Extractor getNewCls(Logger log, JMeterVariables vars, SampleResult prev, boolean printMode = false, String testResponse = null) {
        return new Extractor(log, vars, prev, printMode, testResponse)
    }
}


// ####################################################################################################################################################################
// Регистрация фабрики в глобальных свойствах JMeter.
// После выполнения этого скрипта (обычно в setUp Thread Group) объект ResponseExtractor становится доступен во всех последующих JSR223-элементах через props.
props.put("ResponseExtractor", ResponseExtractor)
