/**
 * VER 2.0
 * Класс для извлечения UUID (уникальных идентификаторов) из ответов ZK-приложения.
 * Результат сохраняется в переменную JMeter (vars) и возвращается как строка.
 * Скрипт предназначен для использования в JSR223 PostProcessor / Sampler в Apache JMeter.
 * Основная задача — парсить большие JSON/JS-ответы ZK Framework и извлекать идентификаторы
 * элементов дерева навигации и других компонентов по текстовым меткам или границам.
 */

import groovy.transform.CompileStatic
import org.apache.jmeter.threads.JMeterVariables
import org.apache.jmeter.samplers.SampleResult
import org.slf4j.Logger
import org.apache.commons.text.StringEscapeUtils


// ####################################################################################################################################################################
/**
 * Статическая карта транслитерации кириллицы в латиницу. Используется для генерации "чистых" имён переменных JMeter из русских текстовых меток.
 * Например: "Операции по кассовым выплатам" → "Operatsii_po_kassovym_vyplatam"
 */
@CompileStatic
class Translit {
    /** Статическая неизменяемая карта соответствия символов */
    private static final Map<Character, String> MAP = new HashMap<>()
    static {
        MAP.put('А' as char, 'A'); MAP.put('Б' as char, 'B'); MAP.put('В' as char, 'V'); MAP.put('Г' as char, 'G'); MAP.put('Д' as char, 'D'); MAP.put('Е' as char, 'E')
        MAP.put('Ё' as char, 'Yo'); MAP.put('Ж' as char, 'Zh'); MAP.put('З' as char, 'Z'); MAP.put('И' as char, 'I'); MAP.put('Й' as char, 'Y'); MAP.put('К' as char, 'K')
        MAP.put('Л' as char, 'L'); MAP.put('М' as char, 'M'); MAP.put('Н' as char, 'N'); MAP.put('О' as char, 'O'); MAP.put('П' as char, 'P'); MAP.put('Р' as char, 'R')
        MAP.put('С' as char, 'S'); MAP.put('Т' as char, 'T'); MAP.put('У' as char, 'U'); MAP.put('Ф' as char, 'F'); MAP.put('Х' as char, 'Kh'); MAP.put('Ц' as char, 'Ts')
        MAP.put('Ч' as char, 'Ch'); MAP.put('Ш' as char, 'Sh'); MAP.put('Щ' as char, 'Shch'); MAP.put('Ъ' as char, ''); MAP.put('Ы' as char, 'Y'); MAP.put('Ь' as char, '')
        MAP.put('Э' as char, 'E'); MAP.put('Ю' as char, 'Yu'); MAP.put('Я' as char, 'Ya')
        MAP.put('а' as char, 'a'); MAP.put('б' as char, 'b'); MAP.put('в' as char, 'v');  MAP.put('г' as char, 'g'); MAP.put('д' as char, 'd'); MAP.put('е' as char, 'e')
        MAP.put('ё' as char, 'yo'); MAP.put('ж' as char, 'zh'); MAP.put('з' as char, 'z');  MAP.put('и' as char, 'i'); MAP.put('й' as char, 'y'); MAP.put('к' as char, 'k')
        MAP.put('л' as char, 'l'); MAP.put('м' as char, 'm'); MAP.put('н' as char, 'n');  MAP.put('о' as char, 'o'); MAP.put('п' as char, 'p'); MAP.put('р' as char, 'r')
        MAP.put('с' as char, 's'); MAP.put('т' as char, 't'); MAP.put('у' as char, 'u');  MAP.put('ф' as char, 'f'); MAP.put('х' as char, 'kh'); MAP.put('ц' as char, 'ts')
        MAP.put('ч' as char, 'ch'); MAP.put('ш' as char, 'sh'); MAP.put('щ' as char, 'shch'); MAP.put('ъ' as char, ''); MAP.put('ы' as char, 'y'); MAP.put('ь' as char, '')
        MAP.put('э' as char, 'e'); MAP.put('ю' as char, 'yu'); MAP.put('я' as char, 'ya')
    }

    /**
     * Транслитерация строки с кириллицы на латиницу.
     * Алгоритм:
     * 1. Каждый символ заменяется согласно карте MAP.
     * 2. Все символы, не являющиеся буквами/цифрами, заменяются на подчёркивание.
     * 3. Удаляются подряд идущие подчёркивания.
     * 4. Удаляются подчёркивания в начале и конце строки.
     * @param s исходная строка (может содержать кириллицу, пробелы, спецсимволы)
     * @return "чистая" строка, пригодная для использования в качестве имени переменной JMeter
     */
    protected static String transliterate(String s) {
        if (s == null || s.isEmpty()) { return s }
        StringBuilder sb = new StringBuilder(s.length())
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i)
            // Если символ есть в карте — берём транслитерацию, иначе оставляем как есть
            sb.append(MAP.getOrDefault(ch, String.valueOf(ch)))
        }
        // Заменяем всё, кроме букв и цифр, на '_', убираем дубли и края
        return sb.toString().replaceAll(/[^a-zA-Z0-9]/, '_').replaceAll(/_+/, '_').replaceAll(/^_|_$/, '')
    }
}


